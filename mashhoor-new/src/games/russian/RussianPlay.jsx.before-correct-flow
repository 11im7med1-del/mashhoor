import { useState } from 'react'

const COLORS = [
  '#9eff28','#24d1ff','#ffb020','#ff5f75',
  '#a978ff','#35e0a1','#ff7a2f','#4d8dff',
  '#e8ff52','#ff5cc8','#72e6ff','#b6ff66',
  '#ffcc4d','#9b7cff','#45d6b5','#ff8f70'
]

function createPlayers(players) {
  return players.slice(0, 30).map((name, index) => ({
    id: `${index}-${name}`,
    name,
    color: COLORS[index % COLORS.length]
  }))
}

export default function RussianPlay({ players, onBack }) {
  const [activePlayers, setActivePlayers] = useState(() => createPlayers(players))

  const [screen, setScreen] = useState('roulette')

  const [rotation, setRotation] = useState(0)
  const [spinning, setSpinning] = useState(false)
  const [selectedPlayer, setSelectedPlayer] = useState(null)

  // طلقة واحدة بمكان عشوائي من 6
  const [loadedChamber, setLoadedChamber] = useState(
    () => Math.floor(Math.random() * 6)
  )

  const [triggerIndex, setTriggerIndex] = useState(0)
  const [gunLocked, setGunLocked] = useState(false)
  const [gunState, setGunState] = useState('ready')

  const champion =
    activePlayers.length === 1
      ? activePlayers[0]
      : null

  const part =
    activePlayers.length
      ? 360 / activePlayers.length
      : 360

  const wheelBackground =
    activePlayers.length
      ? `conic-gradient(${activePlayers.map((player, index) => {
          const start = index * part
          const end = (index + 1) * part

          return `${player.color} ${start}deg ${end}deg`
        }).join(',')})`
      : '#111'

  function playClickSound() {
    try {
      const AudioContext =
        window.AudioContext || window.webkitAudioContext

      const ctx = new AudioContext()
      const osc = ctx.createOscillator()
      const gain = ctx.createGain()

      osc.type = 'square'
      osc.frequency.setValueAtTime(150, ctx.currentTime)

      gain.gain.setValueAtTime(.06, ctx.currentTime)
      gain.gain.exponentialRampToValueAtTime(
        .001,
        ctx.currentTime + .1
      )

      osc.connect(gain)
      gain.connect(ctx.destination)

      osc.start()
      osc.stop(ctx.currentTime + .1)

      setTimeout(() => ctx.close(), 250)
    } catch {}
  }

  function playBangSound() {
    try {
      const AudioContext =
        window.AudioContext || window.webkitAudioContext

      const ctx = new AudioContext()

      const bufferSize = ctx.sampleRate * .35
      const buffer = ctx.createBuffer(
        1,
        bufferSize,
        ctx.sampleRate
      )

      const data = buffer.getChannelData(0)

      for (let i = 0; i < bufferSize; i++) {
        data[i] =
          (Math.random() * 2 - 1) *
          Math.pow(1 - i / bufferSize, 2)
      }

      const noise = ctx.createBufferSource()
      const gain = ctx.createGain()

      noise.buffer = buffer

      gain.gain.setValueAtTime(.22, ctx.currentTime)
      gain.gain.exponentialRampToValueAtTime(
        .001,
        ctx.currentTime + .35
      )

      noise.connect(gain)
      gain.connect(ctx.destination)

      noise.start()

      setTimeout(() => ctx.close(), 500)
    } catch {}
  }

  function spinWheel() {
    if (
      spinning ||
      activePlayers.length <= 1
    ) return

    setSelectedPlayer(null)
    setSpinning(true)

    const selectedIndex =
      Math.floor(
        Math.random() * activePlayers.length
      )

    const player =
      activePlayers[selectedIndex]

    const segment =
      360 / activePlayers.length

    const center =
      selectedIndex * segment +
      segment / 2

    const current =
      ((rotation % 360) + 360) % 360

    const target =
      (360 - center) % 360

    const correction =
      (target - current + 360) % 360

    const next =
      rotation +
      (360 * 7) +
      correction

    setRotation(next)

    setTimeout(() => {
      setSpinning(false)
      setSelectedPlayer(player)

      // يبقى الاسم ظاهر شوي ثم ينتقل لشاشة المسدس
      setTimeout(() => {
        setGunState('ready')
        setScreen('gun')
      }, 900)

    }, 3800)
  }

  function fireGun() {
    if (
      gunLocked ||
      !selectedPlayer
    ) return

    setGunLocked(true)

    const fired =
      triggerIndex === loadedChamber

    if (fired) {
      setGunState('bang')
      playBangSound()

      setTimeout(() => {
        setActivePlayers(current =>
          current.filter(
            player =>
              player.id !== selectedPlayer.id
          )
        )

        setLoadedChamber(
          Math.floor(Math.random() * 6)
        )

        setTriggerIndex(0)
        setSelectedPlayer(null)
        setGunState('ready')
        setGunLocked(false)
        setScreen('roulette')
      }, 1700)

      return
    }

    setGunState('safe')
    playClickSound()

    setTimeout(() => {
      setTriggerIndex(current => current + 1)

      setSelectedPlayer(null)
      setGunState('ready')
      setGunLocked(false)
      setScreen('roulette')
    }, 1100)
  }

  if (champion) {
    return (
      <div className="rr-root rr-winner">
        <style>{styles}</style>

        <div className="rr-winner-card">
          <div className="rr-trophy">🏆</div>

          <small>الفائز في الروليت الروسي</small>

          <h1>{champion.name}</h1>

          <button
            className="rr-dark-btn"
            onClick={onBack}
          >
            رجوع للتجهيز
          </button>
        </div>
      </div>
    )
  }

  return (
    <div className="rr-root">
      <style>{styles}</style>

      <header className="rr-header">

        <button
          className="rr-dark-btn"
          onClick={onBack}
          disabled={spinning || gunLocked}
        >
          رجوع للتجهيز
        </button>

        <div className="rr-title">
          <small>MASHHOOR GAMES</small>
          <h2>الروليت الروسي</h2>
        </div>

        <div className="rr-count">
          {activePlayers.length} لاعبين
        </div>

      </header>

      {screen === 'roulette' && (
        <main className="rr-selection">

          <aside className="rr-players">

            <div className="rr-panel-head">
              <span>اللاعبون</span>
              <b>{activePlayers.length}</b>
            </div>

            <div className="rr-player-list">
              {activePlayers.map((player, index) => (
                <div
                  className="rr-player-row"
                  key={player.id}
                >
                  <span
                    className="rr-player-number"
                    style={{
                      background:player.color
                    }}
                  >
                    {index + 1}
                  </span>

                  <b>{player.name}</b>
                </div>
              ))}
            </div>

          </aside>

          <section className="rr-wheel-stage">

            <div className="rr-screen-label">
              اختيار اللاعب
            </div>

            <div className="rr-wheel-wrap">

              <div className="rr-pointer">
                ▼
              </div>

              <div
                className="rr-wheel"
                style={{
                  background:wheelBackground,
                  transform:
                    `translateX(-50%) rotate(${rotation}deg)`,
                  transition:
                    spinning
                      ? 'transform 3.8s cubic-bezier(.10,.72,.10,1)'
                      : 'none'
                }}
              >

                {activePlayers.map(
                  (player, index) => {
                    const angle =
                      index * part +
                      part / 2

                    const radius =
                      activePlayers.length > 18
                        ? 180
                        : 170

                    return (
                      <div
                        className="rr-wheel-name"
                        key={player.id}
                        style={{
                          transform:
                            `rotate(${angle}deg) translateY(-${radius}px) rotate(${-angle}deg)`
                        }}
                      >
                        <b style={{
                          fontSize:
                            activePlayers.length > 20
                              ? 8
                              : activePlayers.length > 12
                                ? 10
                                : 12
                        }}>
                          {player.name}
                        </b>
                      </div>
                    )
                  }
                )}

                <button
                  className="rr-wheel-center"
                  onClick={spinWheel}
                  disabled={spinning}
                >
                  <b>مشهور</b>
                  <small>
                    {spinning
                      ? 'تدور...'
                      : 'اضغط'}
                  </small>
                </button>

              </div>

            </div>

            <div className="rr-selected-name">
              <small>
                {spinning
                  ? 'جاري الاختيار'
                  : selectedPlayer
                    ? 'تم الاختيار'
                    : 'اضغط على منتصف العجلة'}
              </small>

              <h1>
                {selectedPlayer
                  ? selectedPlayer.name
                  : '—'}
              </h1>
            </div>

          </section>

        </main>
      )}

      {screen === 'gun' && selectedPlayer && (
        <main
          className={
            `rr-gun-screen ${
              gunState === 'bang'
                ? 'is-bang'
                : gunState === 'safe'
                  ? 'is-safe'
                  : ''
            }`
          }
        >

          <div className="rr-gun-player">
            <small>الدور على</small>
            <h1>{selectedPlayer.name}</h1>
          </div>

          <button
            className="rr-gun-button"
            onClick={fireGun}
            disabled={gunLocked}
            aria-label="الزناد"
          >

            <div className="rr-revolver">

              <div className="rr-barrel" />

              <div className="rr-barrel-tip" />

              <div className="rr-body">

                <div className="rr-cylinder">
                  {[0,1,2,3,4,5].map(i => (
                    <span key={i} />
                  ))}
                </div>

              </div>

              <div className="rr-trigger-ring">
                <div className="rr-trigger" />
              </div>

              <div className="rr-grip" />

            </div>

          </button>

          <div className="rr-gun-result">

            {gunState === 'ready' && (
              <span className="rr-ready-dot">
                ●
              </span>
            )}

            {gunState === 'safe' && (
              <h2 className="rr-safe-text">
                نجا
              </h2>
            )}

            {gunState === 'bang' && (
              <h2 className="rr-bang-text">
                💥 خرج من اللعبة
              </h2>
            )}

          </div>

        </main>
      )}

    </div>
  )
}

