]

const TEAM_COLORS = {
  red: '#ff4f5e',
  blue: '#438cff'
}

const SPEEDS = {
  fast: {
    label: 'سريع',
    duration: 3000
  },
  normal: {
    label: 'متوازن',
    duration: 4200
  },
  slow: {
    label: 'هادئ',
    duration: 5400
  }
}

function makePlayers(players, mode) {
  const base = players.slice(0, 30).map((name, index) => ({
    id: `${index}-${name}`,
    name,
    number: index + 1,
    team: null,
    color: COLORS[index % COLORS.length]
  }))

  if (mode !== 'teams') {
    return base
  }

  // خلط عشوائي حقيقي
  const mixed = [...base]

  for (let i = mixed.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1))

    const temp = mixed[i]
    mixed[i] = mixed[j]
    mixed[j] = temp
  }

  // الفريق الذي يأخذ اللاعب الإضافي يتغير عشوائياً
  const firstTeam =
    Math.random() < 0.5 ? 'red' : 'blue'

  const secondTeam =
    firstTeam === 'red' ? 'blue' : 'red'

  return mixed.map((player, index) => {
    const team =
      index % 2 === 0
        ? firstTeam
        : secondTeam

    return {
      ...player,
      team,
      color: TEAM_COLORS[team]
    }
  })
}

export default function RoulettePlay({ players, mode, onBack }) {
  const [activePlayers, setActivePlayers] = useState(() => makePlayers(players, mode))
  const [eliminated, setEliminated] = useState([])

  const [rotation, setRotation] = useState(0)
  const [spinning, setSpinning] = useState(false)

  const [winner, setWinner] = useState(null)
  const [waitingForChoice, setWaitingForChoice] = useState(false)

  const [speed, setSpeed] = useState('normal')
  const [soundOn, setSoundOn] = useState(true)

  const [history, setHistory] = useState([])
  const [effect, setEffect] = useState(null)

  useEffect(() => {
    function receiveMessage(event) {
      const detail = event.detail || {}

      handleChatCommand(
        detail.senderName ?? detail.sender ?? '',
        detail.message ?? detail.text ?? ''
      )
    }

    window.addEventListener(
      'mashhoor-chat-message',
      receiveMessage
    )

    window.mashhoorRouletteChat = (senderName, message) => {
      window.dispatchEvent(
        new CustomEvent('mashhoor-chat-message', {
          detail: {
            senderName,
            message
          }
        })
      )
    }

    return () => {
      window.removeEventListener(
        'mashhoor-chat-message',
        receiveMessage
      )

      delete window.mashhoorRouletteChat
    }
  }, [winner, waitingForChoice, activePlayers, eliminated])

  const count = activePlayers.length
  const part = count ? 360 / count : 360

  const wheelBackground = count
    ? `conic-gradient(${activePlayers.map((player, i) => {
        const start = i * part
        const end = (i + 1) * part
        return `${player.color} ${start}deg ${end}deg`
      }).join(',')})`
    : '#111'

  function tone(frequency = 440, duration = 0.15, volume = 0.06) {
    if (!soundOn) return

    try {
      const AudioContext =
        window.AudioContext || window.webkitAudioContext

      const ctx = new AudioContext()
      const oscillator = ctx.createOscillator()
      const gain = ctx.createGain()

      oscillator.type = 'sine'
      oscillator.frequency.setValueAtTime(frequency, ctx.currentTime)

      gain.gain.setValueAtTime(volume, ctx.currentTime)
      gain.gain.exponentialRampToValueAtTime(
        0.001,
        ctx.currentTime + duration
      )

      oscillator.connect(gain)
      gain.connect(ctx.destination)

      oscillator.start()
      oscillator.stop(ctx.currentTime + duration)

      window.setTimeout(() => {
        ctx.close()
      }, (duration * 1000) + 150)
    } catch {
      // تجاهل أخطاء الصوت
    }
  }

  function spinSound(duration) {
    if (!soundOn) return

    try {
      const AudioContext =
        window.AudioContext || window.webkitAudioContext

      const ctx = new AudioContext()
      const oscillator = ctx.createOscillator()
      const gain = ctx.createGain()

      oscillator.type = 'triangle'

      oscillator.frequency.setValueAtTime(
        175,
        ctx.currentTime
      )

      oscillator.frequency.exponentialRampToValueAtTime(
        45,
        ctx.currentTime + duration / 1000
      )

      gain.gain.setValueAtTime(
        0.025,
        ctx.currentTime
      )

      gain.gain.exponentialRampToValueAtTime(
        0.001,
        ctx.currentTime + duration / 1000
      )

      oscillator.connect(gain)
      gain.connect(ctx.destination)

      oscillator.start()
      oscillator.stop(
        ctx.currentTime + duration / 1000
      )

      window.setTimeout(() => {
        ctx.close()
      }, duration + 300)
    } catch {
      // تجاهل أخطاء الصوت
    }
  }

  function spin() {
    if (spinning) return
    if (count <= 1) return

    setWinner(null)
    setWaitingForChoice(false)
    setSpinning(true)

    const selectedIndex =
      Math.floor(Math.random() * count)

    const selectedPlayer =
      activePlayers[selectedIndex]

    const segment = 360 / count

    const selectedCenter =
      selectedIndex * segment + segment / 2

    const currentAngle =
      ((rotation % 360) + 360) % 360

    const targetAngle =
      (360 - selectedCenter) % 360

    const correction =
      (targetAngle - currentAngle + 360) % 360

    const extraTurns =
      360 * (7 + Math.floor(Math.random() * 3))

    const nextRotation =
      rotation + extraTurns + correction

    const duration =
      SPEEDS[speed].duration

    spinSound(duration)

    setRotation(nextRotation)

    window.setTimeout(() => {
      setWinner(selectedPlayer)

      setHistory(old => [
        selectedPlayer,
        ...old
      ].slice(0, 6))

      setSpinning(false)
      setWaitingForChoice(true)

      tone(720, 0.25, 0.08)
    }, duration)
  }

  function normalizeName(value = '') {
    return String(value).trim().toLowerCase()
  }

  function normalizeDigits(value = '') {
    const arabic = '٠١٢٣٤٥٦٧٨٩'

    return String(value).replace(/[٠-٩]/g, digit =>
      arabic.indexOf(digit)
    )
  }

  function eliminatePlayer(targetPlayer) {
    if (!targetPlayer || !winner || !waitingForChoice) return

    // ممنوع صاحب الدور يطرد نفسه
    if (targetPlayer.id === winner.id) {
      tone(180, 0.18, 0.06)
      return
    }

    // في وضع الفرق: الطرد من الفريق الخصم فقط
    if (
      mode === 'teams' &&
      targetPlayer.team === winner.team
    ) {
      tone(180, 0.18, 0.06)
      return
    }

    setWaitingForChoice(false)

    setEffect({
      type: 'eliminate',
      name: targetPlayer.name
    })

    tone(130, 0.32, 0.09)

    window.setTimeout(() => {
      setActivePlayers(current =>
        current.filter(player => player.id !== targetPlayer.id)
      )

      setEliminated(current => [
        ...current,
        targetPlayer
      ])

      setWinner(null)
    }, 500)

    window.setTimeout(() => {
      setEffect(null)
    }, 1500)
  }

  function handleChatCommand(senderName, rawMessage) {
    const sender = normalizeName(senderName)
    const message = normalizeDigits(rawMessage).trim()

    if (!sender || !message) return

    // إنعاش لاعب مطرود
    if (message === '!انعاش') {
      const removedPlayer = eliminated.find(
        player => normalizeName(player.name) === sender
      )

      if (removedPlayer) {
        revivePlayer(removedPlayer)
      }

      return
    }

    // لازم تكون العجلة اختارت لاعب
    if (!winner || !waitingForChoice) return

    // فقط صاحب الدور يستطيع الطرد
    if (normalizeName(winner.name) !== sender) return

    // صاحب الدور يكتب رقم اللاعب فقط
    if (!/^\d+$/.test(message)) return

    const number = Number(message)

    const target = activePlayers.find(
      player => player.number === number
    )

    if (!target) return

    eliminatePlayer(target)
  }

  function revivePlayer(player) {
    setEliminated(current =>
      current.filter(p => p.id !== player.id)
    )

    setActivePlayers(current => [
      ...current,
      player
    ])

    setEffect({
      type: 'revive',
      name: player.name
    })

    tone(620, 0.12, 0.07)

    window.setTimeout(() => {
      tone(850, 0.18, 0.06)
    }, 100)

    window.setTimeout(() => {
      setEffect(null)
    }, 1400)
  }

  const redCount = activePlayers.filter(
    player => player.team === 'red'
  ).length

  const blueCount = activePlayers.filter(
    player => player.team === 'blue'
  ).length

  const winningTeam =
    mode === 'teams' && activePlayers.length > 0
      ? redCount === 0
        ? 'blue'
        : blueCount === 0
          ? 'red'
          : null
      : null

  const champion =
    mode === 'teams'
      ? winningTeam
        ? {
