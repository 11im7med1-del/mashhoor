import { useState } from 'react'

export default function RussianPlay({ players, onBack }) {
  const [currentIndex, setCurrentIndex] = useState(0)
  const [chamber, setChamber] = useState(() => Math.floor(Math.random() * 6))
  const [shotIndex, setShotIndex] = useState(0)
  const [locked, setLocked] = useState(false)
  const [result, setResult] = useState('')
  const [eliminated, setEliminated] = useState([])

  const activePlayers = players.filter(
    player => !eliminated.includes(player)
  )

  const currentPlayer =
    activePlayers.length > 0
      ? activePlayers[currentIndex % activePlayers.length]
      : null

  function sound(type) {
    try {
      const AudioContext =
        window.AudioContext || window.webkitAudioContext

      const ctx = new AudioContext()
      const osc = ctx.createOscillator()
      const gain = ctx.createGain()

      osc.type = type === 'bang' ? 'sawtooth' : 'square'
      osc.frequency.value = type === 'bang' ? 90 : 220

      gain.gain.setValueAtTime(
        type === 'bang' ? 0.12 : 0.04,
        ctx.currentTime
      )

      gain.gain.exponentialRampToValueAtTime(
        0.001,
        ctx.currentTime + (type === 'bang' ? 0.35 : 0.08)
      )

      osc.connect(gain)
      gain.connect(ctx.destination)

      osc.start()
      osc.stop(
        ctx.currentTime + (type === 'bang' ? 0.35 : 0.08)
      )
    } catch {}
  }

  function pullTrigger() {
    if (locked || !currentPlayer) return

    setLocked(true)

    const fired = shotIndex === chamber

    if (fired) {
      sound('bang')
      setResult(`💥 ${currentPlayer}`)

      window.setTimeout(() => {
        setEliminated(old => [...old, currentPlayer])

        const remaining = activePlayers.filter(
          player => player !== currentPlayer
        )

        setShotIndex(0)
        setChamber(Math.floor(Math.random() * 6))
        setResult('')
        setLocked(false)

        if (remaining.length > 1) {
          setCurrentIndex(
            currentIndex % remaining.length
          )
        }
      }, 1800)

      return
    }

    sound('click')
    setResult(`✓ نجا ${currentPlayer}`)

    window.setTimeout(() => {
      setShotIndex(old => old + 1)
      setCurrentIndex(
        old =>
          activePlayers.length
            ? (old + 1) % activePlayers.length
            : 0
      )

      setResult('')
      setLocked(false)
    }, 1200)
  }

  const champion =
    activePlayers.length === 1
      ? activePlayers[0]
      : null

  return (
    <div style={{
      minHeight:'100vh',
      background:
        'radial-gradient(circle at 50% 15%, rgba(158,255,40,.06), transparent 30%), #050705',
      color:'#fff',
      direction:'rtl',
      padding:'24px'
    }}>

      <header style={{
        maxWidth:'1100px',
        margin:'0 auto 30px',
        display:'flex',
        alignItems:'center',
        justifyContent:'space-between'
      }}>
        <button
          onClick={onBack}
          style={{
            border:'1px solid #293229',
            background:'#0a0e0a',
            color:'#fff',
            borderRadius:'10px',
            padding:'10px 15px',
            cursor:'pointer'
          }}
        >
          رجوع للتجهيز
        </button>

        <h2 style={{margin:0}}>
          الروليت الروسي
        </h2>

        <span style={{
          color:'#9eff28',
          fontSize:'12px'
        }}>
          {activePlayers.length} لاعبين
        </span>
      </header>

      <main style={{
        maxWidth:'900px',
        margin:'auto',
        textAlign:'center'
      }}>

        {!champion && currentPlayer && (
          <>
            <small style={{
              color:'#6e796e'
            }}>
              الدور على
            </small>

            <h1 style={{
              fontSize:'48px',
              margin:'8px 0 30px',
              color:'#9eff28'
            }}>
              {currentPlayer}
            </h1>

            <div style={{
              width:'min(520px,92vw)',
              minHeight:'300px',
              margin:'auto',
              display:'grid',
              placeItems:'center',
              border:'1px solid #202820',
              borderRadius:'24px',
              background:'#080c08',
              boxShadow:'0 30px 80px rgba(0,0,0,.35)'
            }}>

              <div>
                <div style={{
                  fontSize:'100px',
                  transform:locked ? 'rotate(-7deg)' : 'rotate(0deg)',
                  transition:'.18s'
                }}>
                  🔫
                </div>

                <div style={{
                  display:'flex',
                  justifyContent:'center',
                  gap:'8px',
                  marginTop:'15px'
                }}>
                  {[0,1,2,3,4,5].map(i => (
                    <span
                      key={i}
                      style={{
                        width:'15px',
                        height:'15px',
                        borderRadius:'50%',
                        border:'1px solid #465046',
                        background:
                          i < shotIndex
                            ? '#202720'
                            : '#0b100b'
                      }}
                    />
                  ))}
                </div>
              </div>

            </div>

            <button
              onClick={pullTrigger}
              disabled={locked}
              style={{
                marginTop:'25px',
                width:'260px',
                minHeight:'54px',
                borderRadius:'12px',
                border:'1px solid #9eff28',
                background:'#9eff28',
                color:'#071007',
                fontWeight:'1000',
                fontSize:'15px',
                cursor:locked ? 'not-allowed' : 'pointer',
                opacity:locked ? .45 : 1
              }}
            >
              {locked ? 'انتظر...' : 'اضغط الزناد'}
            </button>

            <div style={{
              minHeight:'55px',
              marginTop:'18px',
              fontSize:'25px',
              fontWeight:'900'
            }}>
              {result}
            </div>
          </>
        )}

        {champion && (
          <div style={{
            marginTop:'100px',
            padding:'40px',
            border:'1px solid rgba(158,255,40,.3)',
            borderRadius:'24px',
            background:'#080d08'
          }}>
            <div style={{fontSize:'60px'}}>
              🏆
            </div>

            <small style={{color:'#738073'}}>
              الفائز
            </small>

            <h1 style={{
              color:'#9eff28',
              fontSize:'50px',
              margin:'10px'
            }}>
              {champion}
            </h1>
          </div>
        )}

      </main>
    </div>
  )
}
