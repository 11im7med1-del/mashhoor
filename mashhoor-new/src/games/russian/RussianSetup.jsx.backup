import { useState } from 'react'

export default function RussianSetup({ onBack }) {
  const [names, setNames] = useState('')

  const players = names
    .split('\n')
    .map(name => name.trim())
    .filter(Boolean)
    .slice(0, 30)

  return (
    <div style={{
      minHeight:'100vh',
      background:'#050705',
      color:'#fff',
      direction:'rtl',
      padding:'24px'
    }}>
      <div style={{
        maxWidth:'1200px',
        margin:'auto',
        display:'grid',
        gridTemplateColumns:'330px 1fr',
        gap:'35px'
      }}>

        <aside style={{
          border:'1px solid #202820',
          borderRadius:'18px',
          padding:'18px',
          background:'#090d09'
        }}>
          <button onClick={onBack}>
            رجوع
          </button>

          <h3>اللاعبون</h3>

          <textarea
            value={names}
            onChange={e => setNames(e.target.value)}
            placeholder={'محمد\nأحمد\nخالد'}
            style={{
              width:'100%',
              minHeight:'260px',
              resize:'vertical',
              borderRadius:'12px',
              border:'1px solid #2a332a',
              background:'#070a07',
              color:'#fff',
              padding:'12px',
              fontFamily:'inherit'
            }}
          />

          <div style={{marginTop:'10px', color:'#8a968a'}}>
            {players.length} / 30 لاعب
          </div>
        </aside>

        <main style={{
          display:'grid',
          placeItems:'center',
          minHeight:'70vh'
        }}>
          <div style={{
            width:'min(620px,100%)',
            textAlign:'center',
            border:'1px solid #202820',
            borderRadius:'22px',
            padding:'35px',
            background:'#080c08'
          }}>
            <small style={{
              color:'#9eff28',
              letterSpacing:'3px'
            }}>
              MASHHOOR GAMES
            </small>

            <h1 style={{
              fontSize:'42px',
              margin:'12px 0'
            }}>
              الروليت الروسي
            </h1>

            <p style={{
              color:'#7d887d',
              lineHeight:1.8
            }}>
              أضف اللاعبين ثم ابدأ الجولة
            </p>

            <button
              disabled={players.length < 2}
              style={{
                marginTop:'25px',
                width:'250px',
                minHeight:'52px',
                borderRadius:'12px',
                border:'1px solid #9eff28',
                background:'#9eff28',
                color:'#071007',
                fontWeight:'900',
                opacity:players.length < 2 ? .4 : 1
              }}
            >
              ابدأ اللعبة
            </button>
          </div>
        </main>

      </div>
    </div>
  )
}
