          text-shadow:0 0 30px rgba(158,255,40,.13);
          overflow:hidden;
          text-overflow:ellipsis;
        }

        .stomp-stage{
          position:relative;
          width:260px;
          height:170px;
          margin:5px auto 4px;
        }

        .winner-shoe{
          position:absolute;
          z-index:5;
          top:0;
          left:50%;
          font-size:88px;
          line-height:1;
          filter:drop-shadow(0 12px 12px rgba(0,0,0,.65));
          transform-origin:center bottom;
          animation:winnerStomp .8s cubic-bezier(.22,.8,.25,1) 4;
        }

        @keyframes winnerStomp{
          0%{
            transform:translate(-50%,-60px) rotate(-22deg) scale(.9);
          }

          58%{
            transform:translate(-50%,35px) rotate(5deg) scale(1.14);
          }

          70%{
            transform:translate(-50%,28px) rotate(1deg) scale(1.08);
          }

          100%{
            transform:translate(-50%,-10px) rotate(-10deg) scale(1);
          }
        }

        .zlf-target{
          position:absolute;
          left:50%;
          bottom:12px;
          transform:translateX(-50%);
          width:215px;
          min-height:58px;
          display:grid;
          place-items:center;
          border:1px solid #3a423a;
          border-radius:14px;
          background:#101410;
          color:#b6beb6;
          font-size:18px;
          font-weight:1000;
          box-shadow:
            inset 0 0 20px rgba(0,0,0,.4),
            0 10px 35px rgba(0,0,0,.5);
          animation:zlfHit .8s ease 4;
        }

        @keyframes zlfHit{
          0%,55%,100%{
            transform:translateX(-50%) scale(1);
          }

          62%{
            transform:translateX(-50%) scale(.92,.72);
          }

          73%{
            transform:translateX(-50%) scale(1.04,.95);
          }
        }

        .winner-sub{
          margin-top:5px;
          color:#778478;
          font-size:11px;
        }

        .winner-exit{
          margin-top:18px;
          min-width:190px;
        }

        .decision-backdrop{
          position:fixed;
          inset:0;
          z-index:100;
          display:grid;
          place-items:center;
          background:rgba(0,0,0,.74);
          backdrop-filter:blur(8px);
          padding:20px;
        }

        .decision-card{
          width:min(440px,100%);
          border:1px solid #2a362a;
          border-radius:20px;
          padding:25px;
          text-align:center;
          background:
            radial-gradient(circle at 50% 0,rgba(158,255,40,.08),transparent 38%),
            #090d09;
          box-shadow:0 30px 100px #000;
          animation:decisionIn .25s ease;
        }

        @keyframes decisionIn{
          from{
            opacity:0;
            transform:scale(.94) translateY(8px);
          }
          to{
            opacity:1;
            transform:scale(1) translateY(0);
          }
        }

        .decision-card small{
          color:#778278;
          font-size:10px;
        }

        .decision-card h2{
          margin:7px 0 4px;
          font-size:35px;
          color:#9eff28;
        }

        .decision-card p{
          color:#7c877d;
          font-size:11px;
          margin:0 0 20px;
        }

        .decision-actions{
          display:grid;
          grid-template-columns:1fr 1fr;
          gap:9px;
        }

        .keep-btn,
        .kick-btn{
          border-radius:11px;
          min-height:46px;
          cursor:pointer;
          font-family:inherit;
          font-weight:900;
        }

        .keep-btn{
          border:1px solid #334133;
          background:#101710;
          color:#fff;
        }

        .kick-btn{
          border:1px solid #633438;
          background:#211012;
          color:#ff8f96;
        }

        .effect-layer{
          position:fixed;
          inset:0;
          z-index:150;
          pointer-events:none;
          overflow:hidden;
        }

        .kick-effect{
          position:absolute;
          top:45%;
          left:-180px;
          display:flex;
          align-items:center;
          gap:10px;
          animation:kickAcross 1.35s cubic-bezier(.18,.7,.18,1) forwards;
        }

        .kick-shoe{
          font-size:90px;
          filter:drop-shadow(0 10px 16px #000);
        }

        .kick-tag{
          border:1px solid #363f36;
          border-radius:12px;
          padding:8px 12px;
          background:#080c08;
          color:#fff;
          font-size:12px;
          box-shadow:0 8px 35px #000;
        }

        .kick-tag b{
          display:block;
          color:#ff7e86;
          margin-top:2px;
        }

        @keyframes kickAcross{
          0%{
            left:-220px;
            transform:rotate(-12deg) scale(.7);
          }
          40%{
            transform:rotate(5deg) scale(1.05);
          }
          100%{
            left:110%;
            transform:rotate(16deg) scale(.85);
          }
        }

        .revive-effect{
          position:absolute;
          inset:0;
          display:grid;
          place-content:center;
          text-align:center;
          animation:revivePop 1.25s ease forwards;
        }

        .revive-effect .heart{
          font-size:95px;
          filter:drop-shadow(0 0 28px rgba(158,255,40,.35));
        }

        .revive-effect b{
          margin-top:5px;
          color:#9eff28;
          font-size:25px;
        }

        .revive-effect small{
          margin-top:3px;
          color:#a5b4a4;
        }

        @keyframes revivePop{
          0%{
            opacity:0;
            transform:scale(.4);
          }
          25%{
            opacity:1;
            transform:scale(1.15);
          }
          70%{
            opacity:1;
            transform:scale(1);
          }
          100%{
            opacity:0;
            transform:scale(1.35);
          }
        }

        @media(max-width:920px){
          .roulette-layout{
            grid-template-columns:1fr;
          }

          .roulette-panel{
            order:2;
            width:min(600px,100%);
            margin:auto;
          }

          .roulette-main{
            order:1;
          }

          .player-scroll{
            max-height:220px;
          }
        }

        @media(max-width:600px){
          .roulette-game{
            padding:12px;
          }

          .roulette-top{
            grid-template-columns:1fr auto;
          }

          .roulette-mode{
            display:none;
          }

          .roulette-title{
            text-align:left;
          }

          .wheel-wrap{
            height:390px;
          }

          .wheel{
            width:335px;
            height:335px;
          }

          .pointer{
            font-size:39px;
          }

          .decision-actions{
            grid-template-columns:1fr;
          }
        }
      `}</style>

      <header className="roulette-top">

        <button
          className="dark-btn roulette-back"
          onClick={onBack}
          disabled={spinning}
        >
          رجوع للتجهيز
        </button>

        <div className="roulette-title">
          <small>MASHHOOR GAMES</small>
          <h2>الروليت</h2>
        </div>

        <div className="roulette-mode">
          {mode === 'teams'
            ? 'وضع الفرق'
            : 'الوضع العادي'}
        </div>

      </header>

      <div className="roulette-layout">

        <aside className="roulette-panel">

          <div className="panel-title">
            <span>اللاعبون</span>
            <b>{activePlayers.length} / 30</b>
          </div>

          {mode === 'teams' && (
            <div style={{
              display:'grid',
              gridTemplateColumns:'1fr 1fr',
              gap:'7px',
              marginBottom:'11px'
            }}>

              <div style={{
                minHeight:'38px',
                display:'flex',
                alignItems:'center',
                justifyContent:'space-between',
                padding:'7px 9px',
                border:'1px solid rgba(255,79,94,.25)',
                borderRadius:'9px',
                background:'rgba(255,79,94,.07)',
                color:'#ff7b86',
                fontSize:'11px',
                fontWeight:'900'
              }}>
                <span>🔴 الأحمر</span>
                <b>{redCount}</b>
              </div>

              <div style={{
                minHeight:'38px',
                display:'flex',
                alignItems:'center',
                justifyContent:'space-between',
                padding:'7px 9px',
                border:'1px solid rgba(67,140,255,.25)',
                borderRadius:'9px',
                background:'rgba(67,140,255,.07)',
                color:'#76aaff',
                fontSize:'11px',
                fontWeight:'900'
              }}>
                <span>🔵 الأزرق</span>
                <b>{blueCount}</b>
              </div>

            </div>
          )}

          <div className="player-scroll">

            {activePlayers.map((player, index) => (
              <div
                className="player-row"
                key={player.id}
              >
                <span
                  className="player-color"
                  style={{
                    background:player.color
                  }}
                >
                  {player.number}
                </span>

                <span className="player-name">
                  {player.name}
                </span>

                {mode === 'teams' && (
                  <span style={{
                    marginRight:'auto',
                    borderRadius:'999px',
                    padding:'3px 7px',
                    fontSize:'8px',
                    fontWeight:'900',
                    border:
                      player.team === 'red'
                        ? '1px solid rgba(255,79,94,.35)'
                        : '1px solid rgba(67,140,255,.35)',
                    color:
                      player.team === 'red'
                        ? '#ff7b86'
                        : '#76aaff',
                    background:
                      player.team === 'red'
                        ? 'rgba(255,79,94,.08)'
                        : 'rgba(67,140,255,.08)'
                  }}>
                    {player.team === 'red'
                      ? 'أحمر'
                      : 'أزرق'}
                  </span>
                )}
              </div>
            ))}

            {!activePlayers.length && (
              <div className="empty-list">
                لا يوجد لاعبين
              </div>
            )}

          </div>

          <div className="removed-section">

            <div className="panel-title">
              <span>المطرودون</span>
              <b>{eliminated.length}</b>
            </div>

            {eliminated.length === 0 && (
              <div className="empty-list">
                لا يوجد مطرودين
              </div>
            )}

            {eliminated.map(player => (
              <div
                className="removed-row"
                key={player.id}
              >
                <div className="removed-name">

                  <span
                    className="player-color"
                    style={{
                      background:player.color
                    }}
                  />

                  <span>
                    {player.name}
                  </span>

                </div>

                <button
                  className="revive-btn"
                  onClick={() => revivePlayer(player)}
                  disabled={spinning}
                >
                  💚 إنعاش
                </button>

              </div>
            ))}

          </div>

          <div className="history">

            <h4>آخر نتائج العجلة</h4>

            <div className="history-items">

              {history.length === 0 && (
                <span className="empty-list">
                  —
                </span>
              )}

              {history.map((player, index) => (
                <span
                  className="history-chip"
                  key={`${player.id}-${index}`}
                >
                  {player.name}
                </span>
              ))}

            </div>

          </div>

        </aside>

        <main className="roulette-main">

          <div className="controls-bar">

            <span className="control-label">
              سرعة العجلة
            </span>

            {Object.entries(SPEEDS).map(
              ([key, value]) => (
                <button
                  key={key}
                  className={
                    `speed-btn ${
                      speed === key ? 'active' : ''
                    }`
                  }
                  onClick={() => setSpeed(key)}
                  disabled={spinning}
                >
                  {value.label}
                </button>
              )
            )}

            <button
              className="dark-btn sound-btn"
              onClick={() => setSoundOn(value => !value)}
            >
              {soundOn
                ? '🔊 الصوت'
                : '🔇 مكتوم'}
            </button>

          </div>

          <div className="wheel-wrap">

            <div className="pointer">
              ▼
            </div>

            <div
              className="wheel"
              style={{
                background:wheelBackground,
                transition:
                  spinning
                    ? `transform ${SPEEDS[speed].duration}ms cubic-bezier(.10,.72,.10,1)`
                    : 'none',
                transform:
                  `translateX(-50%) rotate(${rotation}deg)`
              }}
            >

              {activePlayers.map((player, index) => {

                const angle =
                  index * part + part / 2

                let radius = 176

                if (count >= 18) {
                  radius = 184
                }

                if (count >= 25) {
                  radius = 188
                }

                let fontSize = 12

                if (count >= 13) {
                  fontSize = 10
                }

                if (count >= 20) {
                  fontSize = 8
                }

                if (count >= 27) {
                  fontSize = 7
                }

                return (
                  <div
                    key={player.id}
                    className="wheel-label"
                    style={{
                      transform:
                        `rotate(${angle}deg) translateY(-${radius}px) rotate(${-angle}deg)`
                    }}
                  >
                    <b
                      style={{
                        fontSize
                      }}
                    >
                      {player.name}
                    </b>
                  </div>
                )
              })}

              <div
                className="wheel-center"
                onClick={spin}
                role="button"
                title="لف العجلة"
              >
                <b>مشهور</b>
                <small>
                  {spinning ? 'تدور...' : 'اضغط للّف'}
                </small>
              </div>

            </div>

          </div>

          <button
            className="spin-btn"
            onClick={spin}
            disabled={
              spinning ||
              waitingForChoice ||
              activePlayers.length <= 1
            }
          >
            {spinning
              ? 'العجلة تدور...'
              : waitingForChoice && winner
                ? `بانتظار ${winner.name}`
                : activePlayers.length <= 1
                  ? 'انتهت الجولة'
                  : 'لف العجلة'}
          </button>

          <div className="winner-line">

            <small>
              صاحب الدور
            </small>

            <h2>
              {winner
                ? winner.name
                : '—'}
            </h2>

            {waitingForChoice && winner && (
              <div style={{
                margin:'8px auto',
                width:'min(500px,90%)',
                padding:'10px',
                border:'1px solid rgba(158,255,40,.28)',
                borderRadius:'10px',
                background:'rgba(158,255,40,.06)'
              }}>
                <b style={{color:'#9eff28'}}>
                  دور {winner.name}
                </b>

                <div style={{
                  marginTop:'4px',
                  color:'#899589',
                  fontSize:'11px'
                }}>
                  اكتب في الشات: !طرد رقم اللاعب
                </div>
              </div>
            )}

          </div>

          {champion && (
            <div className="champion">
              <small>
                آخر لاعب متبقٍ
              </small>

              <b>
                🏆 {champion.name}
              </b>
            </div>
          )}

        </main>

      </div>

      {waitingForChoice && winner && (
        <div className="decision-backdrop">

          <div
            className="decision-card"
            style={{
              width:'min(620px, 96vw)',
              maxHeight:'88vh',
              overflow:'hidden'
            }}
          >

            <small>
              العجلة اختارت
            </small>

            <h2 style={{
              fontSize:'42px',
              marginBottom:'5px'
            }}>
              {winner.name}
            </h2>

            {mode === 'teams' && (
              <div style={{
                display:'inline-block',
                marginBottom:'10px',
                padding:'5px 12px',
                borderRadius:'999px',
                fontSize:'10px',
                fontWeight:'900',
                color:
                  winner.team === 'red'
                    ? '#ff7b86'
                    : '#76aaff',
                background:
                  winner.team === 'red'
                    ? 'rgba(255,79,94,.08)'
                    : 'rgba(67,140,255,.08)',
                border:
                  winner.team === 'red'
                    ? '1px solid rgba(255,79,94,.3)'
                    : '1px solid rgba(67,140,255,.3)'
              }}>
                {winner.team === 'red'
                  ? '🔴 الفريق الأحمر'
                  : '🔵 الفريق الأزرق'}
              </div>
            )}

            <p style={{
              marginBottom:'14px'
            }}>
              اختَر رقم لاعب
            </p>

            <div style={{
              display:'grid',
              gridTemplateColumns:'repeat(3, minmax(0, 1fr))',
              gap:'8px',
              maxHeight:'380px',
              overflowY:'auto',
              padding:'4px'
            }}>

              {activePlayers
                .filter(player =>
                  player.id !== winner.id &&
                  (
                    mode !== 'teams' ||
                    player.team !== winner.team
                  )
                )
                .map(player => (
                  <button
                    key={player.id}
                    onClick={() => eliminatePlayer(player)}
                    style={{
                      minHeight:'52px',
                      color:'#fff',
                      cursor:'pointer',
                      fontFamily:'inherit',
                      display:'flex',
                      alignItems:'center',
                      gap:'9px',
                      padding:'8px 10px',
                      border:'1px solid #273127',
                      borderRadius:'11px',
                      background:'#080c08',
                      textAlign:'right'
                    }}
                  >

                    <span
                      className="player-color"
                      style={{
                        background:player.color,
                        flex:'0 0 28px',
                        width:'28px',
                        height:'28px'
                      }}
                    >
                      {player.number}
                    </span>

                    <b style={{
                      minWidth:0,
                      overflow:'hidden',
                      whiteSpace:'nowrap',
                      textOverflow:'ellipsis',
                      fontSize:'12px'
                    }}>
                      {player.name}
                    </b>

                  </button>
                ))}

            </div>

            {eliminated.length > 0 && (
              <div style={{
                marginTop:'16px',
                paddingTop:'14px',
                borderTop:'1px solid #202820'
              }}>

                <div style={{
                  color:'#9eff28',
                  fontSize:'11px',
                  fontWeight:'900',
                  marginBottom:'8px'
                }}>
                  المطرودون — إنعاش
                </div>

                <div style={{
                  display:'grid',
                  gridTemplateColumns:'repeat(2, minmax(0,1fr))',
                  gap:'7px',
                  maxHeight:'150px',
                  overflowY:'auto'
                }}>

                  {eliminated.map(player => (
                    <div
                      key={player.id}
                      style={{
                        display:'flex',
                        alignItems:'center',
                        justifyContent:'space-between',
                        gap:'8px',
                        padding:'7px 9px',
                        border:'1px solid #2a302a',
                        borderRadius:'9px',
                        background:'#0b0d0b'
                      }}
                    >

                      <span style={{
                        overflow:'hidden',
                        textOverflow:'ellipsis',
                        whiteSpace:'nowrap',
                        fontSize:'11px'
                      }}>
                        {player.number}. {player.name}
                      </span>

                      <button
                        onClick={() => revivePlayer(player)}
                        style={{
                          border:'1px solid #315537',
                          borderRadius:'7px',
                          background:'#0c170e',
                          color:'#aaff85',
                          padding:'5px 8px',
                          cursor:'pointer',
                          fontFamily:'inherit',
                          fontSize:'10px'
                        }}
                      >
                        💚 إنعاش
                      </button>

                    </div>
                  ))}

                </div>

              </div>
            )}

            <div style={{
              marginTop:'15px',
              padding:'9px',
              borderTop:'1px solid #202820',
              color:'#8b978b',
              fontSize:'11px'
            }}>
              {mode === 'teams'
                ? `${winner.name} يختار لاعبًا من الفريق الخصم`
                : `${winner.name} يكتب الرقم في الشات، أو المنظّم يختار اللاعب من القائمة`}
            </div>

          </div>

        </div>
      )}

      {champion && (
        <div className="winner-screen">

          <div className="winner-card">

            <div className="winner-crown">
              🏆
            </div>

            <div className="winner-label">
              الفائز في الروليت
            </div>

            <div className="winner-name">
              {champion.name}
            </div>

            <div className="stomp-stage">

              <div className="winner-shoe">
                👟
              </div>

              <div className="zlf-target">
                موقع زلف
              </div>

            </div>

            <div className="winner-sub">
              آخر لاعب بقي في اللعبة
            </div>

            <button
              className="dark-btn winner-exit"
              onClick={onBack}
            >
              رجوع للتجهيز
            </button>

          </div>

        </div>
      )}

      {effect && (
        <div className="effect-layer">

          {effect.type === 'eliminate' && (
            <div className="kick-effect">

              <div className="kick-shoe">
                👟
              </div>

              <div className="kick-tag">
                موقع مشهور
                <b>
                  تم طرد {effect.name}
                </b>
              </div>

            </div>
          )}

          {effect.type === 'revive' && (
            <div className="revive-effect">

              <div className="heart">
                💚
              </div>

              <b>
                {effect.name}
              </b>

              <small>
                عاد إلى اللعبة
              </small>

            </div>
          )}

        </div>
      )}

    </div>
  )
