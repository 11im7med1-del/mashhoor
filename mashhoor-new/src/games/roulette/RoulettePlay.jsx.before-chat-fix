            ))}

          </div>

          <div className="history">

            <h4>آخر نتائج العجلة</h4>

            <div className="history-items">

              {history.length === 0 && (
                <span className="empty-list">
                  —
                </span>
              )}

              {history.map((player, index) => (
                <span
                  className="history-chip"
                  key={`${player.id}-${index}`}
                >
                  {player.name}
                </span>
              ))}

            </div>

          </div>

        </aside>

        <main className="roulette-main">

          <div className="controls-bar">

            <span className="control-label">
              سرعة العجلة
            </span>

            {Object.entries(SPEEDS).map(
              ([key, value]) => (
                <button
                  key={key}
                  className={
                    `speed-btn ${
                      speed === key ? 'active' : ''
                    }`
                  }
                  onClick={() => setSpeed(key)}
                  disabled={spinning}
                >
                  {value.label}
                </button>
              )
            )}

            <button
              className="dark-btn sound-btn"
              onClick={() => setSoundOn(value => !value)}
            >
              {soundOn
                ? '🔊 الصوت'
                : '🔇 مكتوم'}
            </button>

          </div>

          <div className="wheel-wrap">

            <div className="pointer">
              ▼
            </div>

            <div
              className="wheel"
              style={{
                background:wheelBackground,
                transition:
                  spinning
                    ? `transform ${SPEEDS[speed].duration}ms cubic-bezier(.10,.72,.10,1)`
                    : 'none',
                transform:
                  `translateX(-50%) rotate(${rotation}deg)`
              }}
            >

              {activePlayers.map((player, index) => {

                const angle =
                  index * part + part / 2

                let radius = 176

                if (count >= 18) {
                  radius = 184
                }

                if (count >= 25) {
                  radius = 188
                }

                let fontSize = 12

                if (count >= 13) {
                  fontSize = 10
                }

                if (count >= 20) {
                  fontSize = 8
                }

                if (count >= 27) {
                  fontSize = 7
                }

                return (
                  <div
                    key={player.id}
                    className="wheel-label"
                    style={{
                      transform:
                        `rotate(${angle}deg) translateY(-${radius}px) rotate(${-angle}deg)`
                    }}
                  >
                    <b
                      style={{
                        fontSize
                      }}
                    >
                      {player.name}
                    </b>
                  </div>
                )
              })}

              <div className="wheel-center">
                <b>مشهور</b>
                <small>ROULETTE</small>
              </div>

            </div>

          </div>

          <button
            className="spin-btn"
            onClick={spin}
            disabled={
              spinning ||
              decisionOpen ||
              activePlayers.length <= 1
            }
          >
            {spinning
              ? 'العجلة تدور...'
              : activePlayers.length <= 1
                ? 'انتهت الجولة'
                : 'لف العجلة'}
          </button>

          <div className="winner-line">

            <small>
              اختيار العجلة
            </small>

            <h2>
              {winner
                ? winner.name
                : '—'}
            </h2>

          </div>

          {champion && (
            <div className="champion">
              <small>
                آخر لاعب متبقٍ
              </small>

              <b>
                🏆 {champion.name}
              </b>
            </div>
          )}

        </main>

      </div>

      {decisionOpen && winner && (
        <div className="decision-backdrop">

          <div className="decision-card">

            <small>
              العجلة اختارت
            </small>

            <h2>
              {winner.name}
            </h2>

            <p>
              اختر ماذا تريد أن تفعل باللاعب
            </p>

            <div className="decision-actions">

              <button
                className="keep-btn"
                onClick={keepPlayer}
              >
                إبقاء اللاعب
              </button>

              <button
                className="kick-btn"
                onClick={eliminatePlayer}
              >
                👟 طرد اللاعب
              </button>

            </div>

          </div>

        </div>
      )}

      {effect && (
        <div className="effect-layer">

          {effect.type === 'eliminate' && (
            <div className="kick-effect">

              <div className="kick-shoe">
                👟
              </div>

              <div className="kick-tag">
                موقع مشهور
                <b>
                  تم طرد {effect.name}
                </b>
              </div>

            </div>
          )}

          {effect.type === 'revive' && (
            <div className="revive-effect">

              <div className="heart">
                💚
              </div>

              <b>
                {effect.name}
              </b>

              <small>
                عاد إلى اللعبة
              </small>

            </div>
          )}

        </div>
      )}

    </div>
  )
}
