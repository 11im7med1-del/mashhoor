              <p>
                نفس هوية مشهور،
                لكن بدون نسخ نفس الشاشة
                على كل الألعاب.
              </p>
            </article>

            <article>
              <b>04</b>
              <h3>الحركة لها سبب</h3>
              <p>
                الأنيميشن يخدم اللحظة
                بدل ما يكون مجرد زحمة.
              </p>
            </article>

          </div>
        </section>

        <section
          className="mh-contact"
          id="mh-contact"
        >
          <div>
            <span>تواصل</span>
            <h2>
              عندك اقتراح أو فكرة؟
            </h2>
            <p>
              تواصل معي مباشرة على Discord.
            </p>
          </div>

          <button
            onClick={() =>
              navigator.clipboard?.writeText(
                copy.discord
              )
            }
          >
            <small>DISCORD</small>
            <b>{copy.discord}</b>
            <span>نسخ ←</span>
          </button>
        </section>

      </main>

      <footer className="mh-footer">
        <div>
          <img
            src="/mashhoor-mark.svg"
            alt=""
          />
          <span>
            <b>مشهور</b>
            <small>
              ألعاب البث التفاعلية
            </small>
          </span>
        </div>

        <p>
          Developed by
          {' '}
          <strong>1im7med</strong>
        </p>
      </footer>

      {devOpen && (
        <DeveloperPanel
          copy={copy}
          setCopy={setCopy}
          kickLinked={kickLinked}
          connectKick={connectKick}
          onClose={() => setDevOpen(false)}
        />
      )}

    </div>
  )
}

function DeveloperPanel({
  copy,
  setCopy,
  kickLinked,
  connectKick,
  onClose
}) {
  const [draft, setDraft] =
    useState(copy)

  function save() {
    localStorage.setItem(
      'mashhoor:home-copy',
      JSON.stringify(draft)
    )

    setCopy(draft)
    onClose()
  }

  function reset() {
    localStorage.removeItem(
      'mashhoor:home-copy'
    )

    setDraft(DEFAULT_COPY)
    setCopy(DEFAULT_COPY)
  }

  return (
    <div
      className="mh-dev-backdrop"
      onMouseDown={event => {
        if (
          event.target ===
          event.currentTarget
        ) {
          onClose()
        }
      }}
    >
      <section className="mh-dev-panel">

        <header>
          <div>
            <small>
              MASHHOOR · DEVELOPER
            </small>
            <h2>لوحة المطور</h2>
          </div>

          <button onClick={onClose}>
            ×
          </button>
        </header>

        <div className="mh-dev-grid">

          <article>
            <h3>الرئيسية</h3>

            <label>
              العنوان الأول
              <input
                value={draft.heroTitle}
                onChange={e =>
                  setDraft({
                    ...draft,
                    heroTitle:e.target.value
                  })
                }
              />
            </label>

            <label>
              العنوان الأخضر
              <input
                value={draft.heroAccent}
                onChange={e =>
                  setDraft({
                    ...draft,
                    heroAccent:e.target.value
                  })
                }
              />
            </label>

            <label>
              وصف مشهور
              <textarea
                value={draft.heroText}
                onChange={e =>
                  setDraft({
                    ...draft,
                    heroText:e.target.value
                  })
                }
              />
            </label>
          </article>

          <article>
            <h3>عن المطور</h3>

            <label>
              كلام عني
              <textarea
                value={draft.about}
                onChange={e =>
                  setDraft({
                    ...draft,
                    about:e.target.value
                  })
                }
              />
            </label>

            <label>
              فلسفتي
              <textarea
                value={draft.philosophy}
                onChange={e =>
                  setDraft({
                    ...draft,
                    philosophy:e.target.value
                  })
                }
              />
            </label>

            <label>
              فكرة مشهور
              <textarea
                value={draft.vision}
                onChange={e =>
                  setDraft({
                    ...draft,
                    vision:e.target.value
                  })
                }
              />
            </label>
          </article>

          <article>
            <h3>KICK</h3>

            <div className="mh-dev-kick">
              <span>
                {kickLinked
                  ? 'الحساب مرتبط'
                  : 'الحساب غير مرتبط'}
              </span>

              <button
                onClick={connectKick}
              >
                {kickLinked
                  ? 'فصل KICK'
                  : 'ربط KICK'}
              </button>
            </div>

            <label>
              Discord
              <input
                value={draft.discord}
                onChange={e =>
                  setDraft({
                    ...draft,
                    discord:e.target.value
                  })
                }
              />
            </label>
          </article>

        </div>

        <div className="mh-dev-actions">
          <button
            className="save"
            onClick={save}
          >
            حفظ التعديلات
          </button>

          <button
            onClick={reset}
          >
            استعادة النصوص
          </button>
        </div>

      </section>
    </div>
  )
}
