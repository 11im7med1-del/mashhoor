/* =========================================
   MASHHOOR — PREMIUM HOME
   Homepage only. Game logic/styles untouched.
   ========================================= */

.site {
  --m-green: #a4ff38;
  --m-green-2: #79e91d;
  --m-line: rgba(164,255,56,.14);
  --m-border: rgba(255,255,255,.075);
  --m-muted: #79847c;
  --m-panel: rgba(10,14,10,.78);

  min-height: 100vh;
  overflow: clip;
  isolation: isolate;
  background:
    radial-gradient(circle at 75% 3%, rgba(152,255,48,.105), transparent 23%),
    radial-gradient(circle at 12% 48%, rgba(81,189,89,.055), transparent 26%),
    linear-gradient(180deg,#050805 0%,#040604 45%,#030403 100%);
}

.site::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: .34;
  background-image:
    radial-gradient(circle at center, rgba(255,255,255,.17) 0 1px, transparent 1.2px);
  background-size: 34px 34px;
  mask-image:
    radial-gradient(ellipse at 50% 25%, #000 0%, transparent 63%);
}

.site::after {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(90deg, rgba(0,0,0,.3), transparent 18%, transparent 82%, rgba(0,0,0,.3)),
    linear-gradient(180deg, transparent 65%, rgba(0,0,0,.3));
}

.site .grid-bg {
  left: -28%;
  right: -28%;
  bottom: -37%;
  height: 103%;
  opacity: .42;

  background-image:
    linear-gradient(rgba(164,255,56,.16) 1px, transparent 1px),
    linear-gradient(90deg, rgba(164,255,56,.16) 1px, transparent 1px);

  background-size: 72px 72px;
  transform: perspective(720px) rotateX(68deg);
  transform-origin: bottom center;

  mask-image:
    linear-gradient(to top, #000 5%, rgba(0,0,0,.9) 25%, transparent 78%);

  animation: mashhoorGridFlow 14s linear infinite;
}

@keyframes mashhoorGridFlow {
  from {
    background-position: 0 0, 0 0;
  }

  to {
    background-position: 0 72px, 72px 0;
  }
}

.site .glow {
  opacity: .15;
  filter: blur(105px);
}

.site .glow-one {
  width: 460px;
  height: 460px;
  right: -210px;
  top: 100px;
  background: var(--m-green);
}

.site .glow-two {
  width: 380px;
  height: 380px;
  left: -220px;
  top: 720px;
  background: #36ff83;
}

/* Header */

.site .header {
  width: min(1280px, calc(100% - 42px));
  height: 78px;
  position: sticky;
  top: 0;
  z-index: 60;

  padding: 0 7px;

  border-bottom:
    1px solid rgba(255,255,255,.075);

  background:
    linear-gradient(
      180deg,
      rgba(5,8,5,.92),
      rgba(5,8,5,.7)
    );

  backdrop-filter: blur(18px);
}

.site .header::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: -1px;
  width: 150px;
  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      var(--m-green)
    );

  box-shadow:
    0 0 15px rgba(164,255,56,.5);
}

.site .logo {
  gap: 12px;
  user-select: none;
}

.site .logo-box {
  width: 44px;
  height: 44px;
  border-radius: 13px;

  background:
    linear-gradient(145deg,#c4ff65,#87ef20);

  color: #071004;

  border:
    1px solid rgba(255,255,255,.28);

  box-shadow:
    0 0 0 5px rgba(164,255,56,.035),
    0 8px 30px rgba(164,255,56,.12);

  transform: rotate(-2deg);
}

.site .logo b {
  font-size: 21px;
  letter-spacing: -.5px;
}

.site .logo span {
  color: #58625a;
}

.site .header nav {
  gap: 4px;
  padding: 4px;

  border:
    1px solid rgba(255,255,255,.055);

  border-radius: 13px;

  background:
    rgba(255,255,255,.018);
}

.site .header nav button {
  min-width: 74px;

  padding: 9px 14px;

  border-radius: 9px;

  color: #7f8981;

  transition:
    color .2s ease,
    background .2s ease,
    transform .2s ease;
}

.site .header nav button:hover {
  color: #f4f8f4;
  background: rgba(255,255,255,.045);
  transform: translateY(-1px);
}

/* Hero */

.site .hero {
  width: min(1280px, calc(100% - 42px));
  min-height: 665px;

  grid-template-columns:
    minmax(0,1.04fr)
    minmax(440px,.96fr);

  gap: clamp(35px,6vw,90px);

  padding: 42px 0 40px;
}

.site .hero-copy {
  position: relative;
  z-index: 4;
}

.site .tag {
  gap: 10px;

  padding: 8px 14px;

  border:
    1px solid rgba(164,255,56,.2);

  background:
    linear-gradient(
      90deg,
      rgba(164,255,56,.075),
      rgba(164,255,56,.02)
    );

  box-shadow:
    inset 0 0 20px rgba(164,255,56,.025);

  color: #aaff43;

  letter-spacing: .2px;
}

.site .tag i {
  animation:
    mashhoorPulse 2s ease-in-out infinite;
}

@keyframes mashhoorPulse {
  0%,100% {
    transform: scale(.85);
    opacity: .65;
  }

  50% {
    transform: scale(1.18);
    opacity: 1;
  }
}

.site .hero h1 {
  max-width: 730px;

  margin: 25px 0 23px;

  font-size:
    clamp(58px,6.1vw,91px);

  line-height: .96;

  letter-spacing: -5px;

  text-wrap: balance;
}

.site .hero h1 span {
  margin-top: 8px;

  color: transparent;

  background:
    linear-gradient(
      115deg,
      #d6ff91 0%,
      #a4ff38 35%,
      #70df18 100%
    );

  background-clip: text;
  -webkit-background-clip: text;

  filter:
    drop-shadow(0 8px 27px rgba(164,255,56,.08));
}

.site .hero-copy > p {
  width: min(620px,100%);

  color: #89938b;

  font-size: 15px;

  line-height: 2.05;
}

.site .hero-buttons {
  margin-top: 31px;
  gap: 10px;
}

.site .start-btn,
.site .outline-btn {
  min-height: 50px;

  border-radius: 12px;

  transition:
    transform .2s ease,
    box-shadow .2s ease,
    border-color .2s ease;
}

.site .start-btn {
  min-width: 175px;

  justify-content: space-between;

  border:
    1px solid #b8ff60;

  background:
    linear-gradient(
      135deg,
      #b7ff58,
      #8ff127
    );

  box-shadow:
    0 12px 38px rgba(164,255,56,.13),
    inset 0 1px rgba(255,255,255,.35);
}

.site .start-btn:hover {
  transform: translateY(-2px);

  box-shadow:
    0 17px 45px rgba(164,255,56,.18);
}

.site .outline-btn {
  border:
    1px solid rgba(255,255,255,.09);

  background:
    rgba(255,255,255,.026);

  color: #d9dfda;
}

.site .outline-btn:hover {
  transform: translateY(-2px);

  border-color:
    rgba(164,255,56,.22);

  background:
    rgba(164,255,56,.035);
}

.site .hero-stats {
  width: min(570px,100%);

  gap: 0;

  margin-top: 44px;
  padding-top: 0;

  border:
    1px solid rgba(255,255,255,.065);

  border-radius: 15px;

  overflow: hidden;

  background:
    rgba(255,255,255,.018);
}

.site .hero-stats div {
  min-width: 0;
  flex: 1;

  padding: 15px 18px;

  border-left:
    1px solid rgba(255,255,255,.055);
}

.site .hero-stats div:last-child {
  border-left: 0;
}

.site .hero-stats b {
  color: #f3f8f3;

  font-size: 17px;
}

.site .hero-stats span {
  color: #667069;

  font-size: 9px;
}

/* Hero visual */

.site .hero-art {
  min-height: 535px;

  perspective: 900px;

  isolation: isolate;
}

.site .hero-art::before {
  content: "";
  position: absolute;

  width: 410px;
  height: 410px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(164,255,56,.09),
      rgba(164,255,56,.025) 38%,
      transparent 68%
    );

  filter: blur(8px);
}

.site .ring {
  border:
    1px solid rgba(164,255,56,.14);

  box-shadow:
    inset 0 0 30px rgba(164,255,56,.012);
}

.site .ring::before {
  content: "";
  position: absolute;

  width: 7px;
  height: 7px;

  top: 50%;
  left: -4px;

  border-radius: 50%;

  background: var(--m-green);

  box-shadow:
    0 0 14px var(--m-green);
}

.site .ring-1 {
  width: 250px;
  height: 250px;

  animation:
    ringSpin 16s linear infinite;
}

.site .ring-2 {
  width: 365px;
  height: 365px;

  border-style: dashed;

  animation:
    ringSpinReverse 27s linear infinite;
}

.site .ring-3 {
  width: 485px;
  height: 485px;

  opacity: .48;

  animation:
    ringSpin 38s linear infinite;
}

@keyframes ringSpin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes ringSpinReverse {
  to {
    transform: rotate(-360deg);
  }
}

.site .center-logo {
  width: 210px;
  height: 210px;

  position: relative;

  border:
    1px solid rgba(164,255,56,.38);

  background:
    radial-gradient(
      circle at 35% 28%,
      rgba(164,255,56,.16),
      transparent 29%
    ),
    linear-gradient(
      145deg,
      rgba(17,25,15,.98),
      rgba(6,10,6,.98)
    );

  box-shadow:
    0 0 0 12px rgba(164,255,56,.018),
    0 0 0 25px rgba(164,255,56,.009),
    0 35px 100px rgba(0,0,0,.48),
    0 0 70px rgba(164,255,56,.075);

  transform:
    rotateX(3deg)
    rotateY(-7deg);
}

.site .center-logo::after {
  content: "";
  position: absolute;
  inset: 10px;

  border:
    1px solid rgba(255,255,255,.05);

  border-radius: 50%;
}

.site .center-logo small {
  color: #667269;
}

.site .center-logo strong {
  font-size: 39px;

  text-shadow:
    0 6px 30px rgba(0,0,0,.5);
}

.site .center-logo span {
  color: #acff49;
}

.site .float-card {
  min-width: 190px;

  padding: 14px 15px;

  border:
    1px solid rgba(255,255,255,.075);

  border-radius: 14px;

  background:
    linear-gradient(
      145deg,
      rgba(17,23,16,.88),
      rgba(8,12,8,.82)
    );

  box-shadow:
    0 22px 60px rgba(0,0,0,.35),
    inset 0 1px rgba(255,255,255,.025);

  backdrop-filter: blur(14px);
}

.site .float-card b {
  color: #ecf2ed;

  font-size: 11px;
}

.site .float-card small {
  color: #69746b;
}

.site .card-a {
  right: 0;
  top: 92px;

  animation:
    floatA 5.5s ease-in-out infinite;
}

.site .card-b {
  left: 0;
  bottom: 88px;

  animation:
    floatB 6.5s ease-in-out infinite;
}

@keyframes floatA {
  0%,100% {
    transform: translateY(0) rotate(1deg);
  }

  50% {
    transform: translateY(-9px) rotate(0);
  }
}

@keyframes floatB {
  0%,100% {
    transform: translateY(0) rotate(-1deg);
  }

  50% {
    transform: translateY(9px) rotate(0);
  }
}

/* Games */

.site .games {
  width: min(1280px, calc(100% - 42px));

  padding:
    95px 0 120px;
}

.site .games::before {
  content: "";
  position: absolute;

  top: 35px;
  right: 0;
  left: 0;

  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(164,255,56,.13),
      transparent
    );
}

.site .section-title {
  align-items: flex-end;

  margin-bottom: 35px;
}

.site .section-title > div > span {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  color: #a8ff45;

  font-size: 9px;

  letter-spacing: .4px;
}

.site .section-title > div > span::before {
  content: "";

  width: 24px;
  height: 1px;

  background: var(--m-green);

  box-shadow:
    0 0 10px rgba(164,255,56,.5);
}

.site .section-title h2 {
  margin-top: 7px;

  font-size:
    clamp(37px,4vw,50px);

  letter-spacing: -2px;
}

.site .section-title p {
  color: #717c74;

  font-size: 11px;

  line-height: 1.9;
}

.site .game-grid {
  grid-template-columns:
    repeat(6,1fr);

  gap: 14px;
}

.site .game-card {
  grid-column: span 2;

  min-height: 305px;

  position: relative;

  overflow: hidden;

  padding: 22px;

  border:
    1px solid rgba(255,255,255,.07);

  border-radius: 19px;

  background:
    radial-gradient(
      circle at 100% 0,
      rgba(164,255,56,.075),
      transparent 31%
    ),
    linear-gradient(
      145deg,
      rgba(16,22,15,.94),
      rgba(7,10,7,.94)
    );

  box-shadow:
    inset 0 1px rgba(255,255,255,.022),
    0 20px 60px rgba(0,0,0,.12);

  transition:
    transform .28s ease,
    border-color .28s ease,
    box-shadow .28s ease;
}

.site .game-card:nth-child(4),
.site .game-card:nth-child(5) {
  grid-column: span 3;
}

.site .game-card::before {
  content: "";
  position: absolute;

  width: 180px;
  height: 180px;

  right: -110px;
  top: -110px;

  border:
    1px solid rgba(164,255,56,.09);

  border-radius: 50%;

  box-shadow:
    0 0 0 35px rgba(164,255,56,.012),
    0 0 0 70px rgba(164,255,56,.008);

  transition:
    transform .35s ease,
    opacity .35s ease;
}

.site .game-card::after {
  content: "";
  position: absolute;

  right: 22px;
  left: 22px;
  bottom: 64px;

  height: 1px;

  background:
    linear-gradient(
      90deg,
      rgba(164,255,56,.12),
      transparent
    );
}

.site .game-card:hover {
  transform:
    translateY(-7px);

  border-color:
    rgba(164,255,56,.28);

  box-shadow:
    0 28px 80px rgba(0,0,0,.24),
    0 0 30px rgba(164,255,56,.025);
}

.site .game-card:hover::before {
  transform:
    translate(-12px,12px)
    scale(1.08);
}

.site .card-top,
.site .card-copy,
.site .game-card > button {
  position: relative;
  z-index: 2;
}

.site .number {
  display: inline-grid;
  place-items: center;

  min-width: 34px;
  height: 23px;

  padding: 0 8px;

  border:
    1px solid rgba(255,255,255,.06);

  border-radius: 999px;

  background:
    rgba(255,255,255,.025);

  color: #566159;

  font-size: 9px;
}

.site .game-icon {
  width: 51px;
  height: 51px;

  border-radius: 14px;

  border:
    1px solid rgba(164,255,56,.16);

  background:
    linear-gradient(
      145deg,
      rgba(164,255,56,.075),
      rgba(164,255,56,.018)
    );

  color: #adff49;

  box-shadow:
    inset 0 0 20px rgba(164,255,56,.025);

  font-size: 24px;
}

.site .card-copy {
  margin-top: 43px;
}

.site .card-copy h3 {
  color: #f0f5f1;

  font-size: 24px;

  letter-spacing: -.6px;
}

.site .card-copy p {
  width: min(330px,100%);

  color: #747f76;

  line-height: 1.85;
}

.site .game-card > button {
  min-height: 45px;

  padding: 0 14px;

  border:
    1px solid rgba(255,255,255,.075);

  border-radius: 11px;

  background:
    rgba(255,255,255,.022);

  color: #cfd6d0;

  transition:
    color .2s ease,
    background .2s ease,
    border-color .2s ease;
}

.site .game-card:hover > button {
  color: #b2ff53;

  border-color:
    rgba(164,255,56,.2);

  background:
    rgba(164,255,56,.035);
}

/* Footer / Contact */

.site footer {
  width: min(1280px, calc(100% - 42px));

  min-height: 105px;

  margin:
    0 auto 26px;

  padding: 22px 25px;

  border:
    1px solid rgba(255,255,255,.07);

  border-radius: 18px;

  background:
    radial-gradient(
      circle at 100% 0,
      rgba(164,255,56,.055),
      transparent 28%
    ),
    rgba(8,12,8,.86);

  box-shadow:
    inset 0 1px rgba(255,255,255,.022),
    0 20px 70px rgba(0,0,0,.15);

  backdrop-filter: blur(12px);
}

.site footer::before {
  content: "تواصل";

  position: absolute;

  top: -10px;
  right: 24px;

  padding: 3px 10px;

  border:
    1px solid rgba(164,255,56,.16);

  border-radius: 999px;

  background: #070a07;

  color: #98ed35;

  font-size: 8px;
}

.site footer b {
  font-size: 22px;
}

.site footer span {
  color: #68726a;
}

.site .discord {
  min-width: 170px;

  padding: 11px 15px;

  border:
    1px solid rgba(164,255,56,.14);

  border-radius: 12px;

  background:
    rgba(164,255,56,.028);

  text-align: left;

  cursor: pointer;

  transition:
    transform .2s ease,
    border-color .2s ease,
    background .2s ease;
}

.site .discord:hover {
  transform: translateY(-2px);

  border-color:
    rgba(164,255,56,.3);

  background:
    rgba(164,255,56,.055);
}

.site .discord small {
  color: #626e65;

  font-size: 7px;

  letter-spacing: 1.5px;
}

.site .discord strong {
  color: #adff4c;

  font-size: 17px;
}

/* Responsive */

@media (max-width: 1000px) {
  .site .hero {
    grid-template-columns: 1fr;
    gap: 0;

    padding-top: 65px;
  }

  .site .hero-copy {
    max-width: 760px;
    margin: auto;

    text-align: center;
  }

  .site .tag {
    margin: auto;
  }

  .site .hero-copy > p {
    margin: auto;
  }

  .site .hero-buttons {
    justify-content: center;
  }

  .site .hero-stats {
    margin-right: auto;
    margin-left: auto;
  }

  .site .hero-art {
    min-height: 500px;
  }

  .site .game-grid {
    grid-template-columns:
      repeat(2,1fr);
  }

  .site .game-card,
  .site .game-card:nth-child(4),
  .site .game-card:nth-child(5) {
    grid-column: span 1;
  }

  .site .game-card:last-child {
    grid-column: 1 / -1;
  }
}

@media (max-width: 650px) {
  .site .header {
    width: calc(100% - 22px);
    height: 68px;

    gap: 8px;
  }

  .site .header nav {
    display: flex;

    gap: 1px;
  }

  .site .header nav button {
    min-width: auto;

    padding: 8px 8px;

    font-size: 10px;
  }

  .site .header nav button:first-child {
    display: none;
  }

  .site .logo-box {
    width: 39px;
    height: 39px;

    border-radius: 11px;
  }

  .site .logo b {
    font-size: 17px;
  }

  .site .logo span {
    display: none;
  }

  .site .hero,
  .site .games,
  .site footer {
    width: calc(100% - 26px);
  }

  .site .hero {
    min-height: auto;

    padding-top: 55px;
  }

  .site .hero h1 {
    margin-top: 20px;

    font-size:
      clamp(47px,14vw,63px);

    letter-spacing: -3px;
  }

  .site .hero-copy > p {
    font-size: 13px;

    line-height: 1.9;
  }

  .site .hero-buttons {
    flex-direction: column;
  }

  .site .start-btn,
  .site .outline-btn {
    width: 100%;
  }

  .site .hero-stats div {
    padding: 13px 8px;
  }

  .site .hero-stats span {
    font-size: 7px;
  }

  .site .hero-art {
    min-height: 415px;

    transform: scale(.88);
  }

  .site .ring-1 {
    width: 210px;
    height: 210px;
  }

  .site .ring-2 {
    width: 300px;
    height: 300px;
  }

  .site .ring-3 {
    width: 390px;
    height: 390px;
  }

  .site .center-logo {
    width: 180px;
    height: 180px;
  }

  .site .center-logo strong {
    font-size: 34px;
  }

  .site .card-a {
    right: -30px;
  }

  .site .card-b {
    left: -30px;
  }

  .site .games {
    padding-top: 75px;
  }

  .site .section-title {
    gap: 14px;

    margin-bottom: 25px;
  }

  .site .game-grid {
    grid-template-columns: 1fr;
  }

  .site .game-card,
  .site .game-card:last-child {
    grid-column: auto;

    min-height: 275px;
  }

  .site footer {
    gap: 18px;

    padding: 21px;

    flex-direction: column;

    align-items: stretch;
  }

  .site .discord {
    width: 100%;

    text-align: right;
  }
}

@media (prefers-reduced-motion: reduce) {
  .site *,
  .site *::before,
  .site *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
  }
}
