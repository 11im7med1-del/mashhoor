                <span>دخول شات</span>
              </div>
            </div>

          </div>

          <div className="mh-hero-stage">
            <div className="mh-stage-ring one" />
            <div className="mh-stage-ring two" />
            <div className="mh-stage-ring three" />

            <img
              className="mh-stage-logo"
              src="/mashhoor-mark.svg"
