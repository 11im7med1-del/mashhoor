  '#9eff28',
  '#24d1ff',
  '#ffb020',
  '#ff5f75',
  '#a978ff',
  '#35e0a1',
  '#ff7a2f',
  '#4d8dff',
  '#e8ff52',
  '#ff5cc8',
  '#72e6ff',
  '#b6ff66',
  '#ffcc4d',
  '#9b7cff',
  '#45d6b5',
  '#ff8f70',
  '#39c6ff',
  '#d5ff39',
  '#ff73a8',
  '#7ce3b2',
  '#ffac45',
  '#758cff',
  '#c67cff',
  '#51e0db',
  '#ffd75a',
  '#80ff91',
  '#ff7070',
  '#63b8ff',
  '#d88aff',
  '#a9ff58'
]

const SPEEDS = {
  fast: {
    label: 'سريع',
    duration: 3000
  },
  normal: {
    label: 'متوازن',
    duration: 4200
  },
  slow: {
    label: 'هادئ',
    duration: 5400
  }
}

function makePlayers(players) {
  return players.slice(0, 30).map((name, index) => ({
    id: `${index}-${name}`,
    name,
    color: COLORS[index % COLORS.length]
  }))
}

export default function RoulettePlay({ players, mode, onBack }) {
  const [activePlayers, setActivePlayers] = useState(() => makePlayers(players))
  const [eliminated, setEliminated] = useState([])

  const [rotation, setRotation] = useState(0)
  const [spinning, setSpinning] = useState(false)

  const [winner, setWinner] = useState(null)
  const [decisionOpen, setDecisionOpen] = useState(false)

  const [speed, setSpeed] = useState('normal')
  const [soundOn, setSoundOn] = useState(true)

  const [history, setHistory] = useState([])
  const [effect, setEffect] = useState(null)

  const count = activePlayers.length
  const part = count ? 360 / count : 360

  const wheelBackground = count
    ? `conic-gradient(${activePlayers.map((player, i) => {
        const start = i * part
        const end = (i + 1) * part
        return `${player.color} ${start}deg ${end}deg`
      }).join(',')})`
    : '#111'

  function tone(frequency = 440, duration = 0.15, volume = 0.06) {
    if (!soundOn) return

    try {
      const AudioContext =
        window.AudioContext || window.webkitAudioContext

      const ctx = new AudioContext()
      const oscillator = ctx.createOscillator()
      const gain = ctx.createGain()

      oscillator.type = 'sine'
      oscillator.frequency.setValueAtTime(frequency, ctx.currentTime)

      gain.gain.setValueAtTime(volume, ctx.currentTime)
      gain.gain.exponentialRampToValueAtTime(
        0.001,
        ctx.currentTime + duration
      )

      oscillator.connect(gain)
      gain.connect(ctx.destination)

      oscillator.start()
      oscillator.stop(ctx.currentTime + duration)

      window.setTimeout(() => {
        ctx.close()
      }, (duration * 1000) + 150)
    } catch {
      // تجاهل أخطاء الصوت
    }
  }

  function spinSound(duration) {
    if (!soundOn) return

    try {
      const AudioContext =
        window.AudioContext || window.webkitAudioContext

      const ctx = new AudioContext()
      const oscillator = ctx.createOscillator()
      const gain = ctx.createGain()

      oscillator.type = 'triangle'

      oscillator.frequency.setValueAtTime(
        175,
        ctx.currentTime
      )

      oscillator.frequency.exponentialRampToValueAtTime(
        45,
        ctx.currentTime + duration / 1000
      )

      gain.gain.setValueAtTime(
        0.025,
        ctx.currentTime
      )

      gain.gain.exponentialRampToValueAtTime(
        0.001,
        ctx.currentTime + duration / 1000
      )

      oscillator.connect(gain)
      gain.connect(ctx.destination)

      oscillator.start()
      oscillator.stop(
        ctx.currentTime + duration / 1000
      )

      window.setTimeout(() => {
        ctx.close()
      }, duration + 300)
    } catch {
      // تجاهل أخطاء الصوت
    }
  }

  function spin() {
    if (spinning) return
    if (count <= 1) return

    setWinner(null)
    setDecisionOpen(false)
    setSpinning(true)

    const selectedIndex =
      Math.floor(Math.random() * count)

    const selectedPlayer =
      activePlayers[selectedIndex]

    const segment = 360 / count

    const selectedCenter =
      selectedIndex * segment + segment / 2

    const currentAngle =
      ((rotation % 360) + 360) % 360

    const targetAngle =
      (360 - selectedCenter) % 360

    const correction =
      (targetAngle - currentAngle + 360) % 360

    const extraTurns =
      360 * (7 + Math.floor(Math.random() * 3))

    const nextRotation =
      rotation + extraTurns + correction

    const duration =
      SPEEDS[speed].duration

    spinSound(duration)

    setRotation(nextRotation)

    window.setTimeout(() => {
      setWinner(selectedPlayer)

      setHistory(old => [
        selectedPlayer,
        ...old
      ].slice(0, 6))

      setSpinning(false)
      setDecisionOpen(true)

      tone(720, 0.25, 0.08)
    }, duration)
  }

  function keepPlayer() {
    setDecisionOpen(false)
    tone(520, 0.12, 0.05)
  }

  function eliminatePlayer() {
    if (!winner) return

    setDecisionOpen(false)

    setEffect({
      type: 'eliminate',
      name: winner.name
    })

    tone(130, 0.32, 0.09)

    window.setTimeout(() => {
      setActivePlayers(current =>
        current.filter(
          player => player.id !== winner.id
        )
      )

      setEliminated(current => [
        ...current,
        winner
      ])

      setWinner(null)
    }, 500)

    window.setTimeout(() => {
      setEffect(null)
    }, 1500)
  }

  function revivePlayer(player) {
    setEliminated(current =>
      current.filter(p => p.id !== player.id)
    )

    setActivePlayers(current => [
      ...current,
      player
    ])

    setEffect({
      type: 'revive',
      name: player.name
    })

    tone(620, 0.12, 0.07)

    window.setTimeout(() => {
      tone(850, 0.18, 0.06)
    }, 100)

    window.setTimeout(() => {
      setEffect(null)
    }, 1400)
  }

  const champion =
    activePlayers.length === 1
      ? activePlayers[0]
      : null

