import { useEffect, useState } from 'react'

const COLORS = [
  '#9eff28','#24d1ff','#ffb020','#ff5f75',
  '#a978ff','#35e0a1','#ff7a2f','#4d8dff',
  '#e8ff52','#ff5cc8','#72e6ff','#b6ff66',
  '#ffcc4d','#9b7cff','#45d6b5','#ff8f70'
]

function createPlayers(players) {
  return players.slice(0, 30).map((name, index) => ({
    id: `${index}-${name}`,
    name,
    number: index + 1,
    color: COLORS[index % COLORS.length]
  }))
}

function normalizeName(value = '') {
  return String(value).trim().toLowerCase()
}

function normalizeDigits(value = '') {
  const arabic = '٠١٢٣٤٥٦٧٨٩'

  return String(value).replace(/[٠-٩]/g, digit =>
    arabic.indexOf(digit)
  )
}

export default function RussianPlay({ players, onBack }) {
  const [activePlayers, setActivePlayers] = useState(
    () => createPlayers(players)
  )

  // roulette -> choose -> gun
  const [screen, setScreen] = useState('roulette')

  const [rotation, setRotation] = useState(0)
  const [spinning, setSpinning] = useState(false)

  // الشخص الذي اختارته العجلة = صاحب القرار
  const [chooser, setChooser] = useState(null)

  // الشخص الذي سيتم إطلاق المحاولة عليه
  const [target, setTarget] = useState(null)

  // مكان الطلقة من 6
  const [loadedChamber, setLoadedChamber] = useState(
    () => Math.floor(Math.random() * 6)
  )

  // رقم المحاولة الحالية: 0 إلى 5
  const [attemptIndex, setAttemptIndex] = useState(0)

  const [gunState, setGunState] = useState('waiting')
  const [gunLocked, setGunLocked] = useState(false)

  const champion =
    activePlayers.length === 1
      ? activePlayers[0]
      : null

  const part =
    activePlayers.length
      ? 360 / activePlayers.length
      : 360

  const wheelBackground =
    activePlayers.length
      ? `conic-gradient(${activePlayers.map((player, index) => {
          const start = index * part
          const end = (index + 1) * part

          return `${player.color} ${start}deg ${end}deg`
        }).join(',')})`
      : '#111'

  function clickSound() {
    try {
      const AudioContext =
        window.AudioContext || window.webkitAudioContext

      const ctx = new AudioContext()
      const osc = ctx.createOscillator()
      const gain = ctx.createGain()

      osc.type = 'square'
      osc.frequency.setValueAtTime(135, ctx.currentTime)

      gain.gain.setValueAtTime(.07, ctx.currentTime)
      gain.gain.exponentialRampToValueAtTime(
        .001,
        ctx.currentTime + .12
      )

      osc.connect(gain)
      gain.connect(ctx.destination)

      osc.start()
      osc.stop(ctx.currentTime + .12)

      setTimeout(() => ctx.close(), 250)
    } catch {}
  }

  function bangSound() {
    try {
      const AudioContext =
        window.AudioContext || window.webkitAudioContext

      const ctx = new AudioContext()
      const length = ctx.sampleRate * .45

      const buffer =
        ctx.createBuffer(1, length, ctx.sampleRate)

      const data =
        buffer.getChannelData(0)

      for (let i = 0; i < length; i++) {
        data[i] =
          (Math.random() * 2 - 1) *
          Math.pow(1 - i / length, 2)
      }

      const source =
        ctx.createBufferSource()

      const gain =
        ctx.createGain()

      source.buffer = buffer

      gain.gain.setValueAtTime(
        .25,
        ctx.currentTime
      )

      gain.gain.exponentialRampToValueAtTime(
        .001,
        ctx.currentTime + .42
      )

      source.connect(gain)
      gain.connect(ctx.destination)

      source.start()

      setTimeout(() => ctx.close(), 600)
    } catch {}
  }

  function spinWheel() {
    if (
      spinning ||
      screen !== 'roulette' ||
      activePlayers.length <= 1
    ) return

    setChooser(null)
    setTarget(null)
    setSpinning(true)

    const selectedIndex =
      Math.floor(
        Math.random() * activePlayers.length
      )

    const selected =
      activePlayers[selectedIndex]

    const segment =
      360 / activePlayers.length

    const selectedCenter =
      selectedIndex * segment +
      segment / 2

    const current =
      ((rotation % 360) + 360) % 360

    const destination =
      (360 - selectedCenter) % 360

    const correction =
      (destination - current + 360) % 360

    const next =
      rotation +
      (360 * (7 + Math.floor(Math.random() * 2))) +
      correction

    setRotation(next)

    setTimeout(() => {
      setSpinning(false)
      setChooser(selected)

      setTimeout(() => {
        setScreen('choose')
      }, 850)

    }, 3900)
  }

  function chooseTarget(player) {
    if (
      screen !== 'choose' ||
      !chooser ||
      player.id === chooser.id
    ) return

    setTarget(player)
    setGunState('waiting')
    setScreen('gun')
  }

  function fireAutomatically() {
    if (
      gunLocked ||
      !target ||
      screen !== 'gun'
    ) return

    setGunLocked(true)

    const fired =
      attemptIndex === loadedChamber

    if (fired) {
      setGunState('bang')
      bangSound()

      setTimeout(() => {
        setActivePlayers(current =>
          current.filter(
            player => player.id !== target.id
          )
        )

        // بعد الطلقة نعيد الأسطوانة من جديد
        setLoadedChamber(
          Math.floor(Math.random() * 6)
        )

        setAttemptIndex(0)
        setChooser(null)
        setTarget(null)
        setGunState('waiting')
        setGunLocked(false)
        setScreen('roulette')
      }, 1900)

      return
    }

    setGunState('safe')
    clickSound()

    setTimeout(() => {
      setAttemptIndex(current =>
        Math.min(current + 1, 5)
      )

      setChooser(null)
      setTarget(null)
      setGunState('waiting')
      setGunLocked(false)
      setScreen('roulette')
    }, 1500)
  }

  // أول ما تدخل شاشة المسدس يطلق تلقائيًا
  useEffect(() => {
    if (
      screen !== 'gun' ||
      !target ||
      gunLocked
    ) return

    const timer = setTimeout(() => {
      fireAutomatically()
    }, 1000)

    return () => clearTimeout(timer)
  }, [screen, target])

  // استقبال رقم من الشات في شاشة الاختيار
  useEffect(() => {
    function receiveMessage(event) {
      if (
        screen !== 'choose' ||
        !chooser
      ) return

      const detail =
        event.detail || {}

      const sender =
        normalizeName(
          detail.senderName ??
          detail.sender ??
          ''
        )

      const message =
        normalizeDigits(
          detail.message ??
          detail.text ??
          ''
        ).trim()

      if (
        sender !==
        normalizeName(chooser.name)
      ) return

      if (!/^\d+$/.test(message)) return

      const number =
        Number(message)

      const player =
        activePlayers.find(
          item =>
            item.number === number &&
            item.id !== chooser.id
        )

      if (player) {
        chooseTarget(player)
      }
    }

    window.addEventListener(
      'mashhoor-chat-message',
      receiveMessage
    )

    window.mashhoorRussianChat =
      (senderName, message) => {
        window.dispatchEvent(
          new CustomEvent(
            'mashhoor-chat-message',
            {
              detail:{
                senderName,
                message
              }
            }
          )
        )
      }

    return () => {
      window.removeEventListener(
        'mashhoor-chat-message',
        receiveMessage
      )

      delete window.mashhoorRussianChat
    }
  }, [
    screen,
    chooser,
    activePlayers
  ])

  if (champion) {
    return (
      <div className="rr-root rr-winner">
        <style>{styles}</style>

        <div className="rr-winner-card">

          <div className="rr-trophy">
            🏆
          </div>

          <small>
            الفائز في الروليت الروسي
          </small>

          <h1>
            {champion.name}
          </h1>

          <button
            className="rr-dark-btn"
            onClick={onBack}
          >
            رجوع للتجهيز
          </button>

        </div>
      </div>
    )
  }

  return (
    <div className="rr-root">
      <style>{styles}</style>

      <header className="rr-header">

        <button
          className="rr-dark-btn"
          onClick={onBack}
          disabled={spinning || gunLocked}
        >
          رجوع للتجهيز
        </button>

        <div className="rr-title">
          <small>MASHHOOR GAMES</small>
          <h2>الروليت الروسي</h2>
        </div>

        <div className="rr-count">
          {activePlayers.length} لاعبين
        </div>

      </header>

      {/* الشاشة الأولى: العجلة */}
      {screen === 'roulette' && (
        <main className="rr-selection">

          <aside className="rr-players">

            <div className="rr-panel-head">
              <span>اللاعبون</span>
              <b>{activePlayers.length}</b>
            </div>

            <div className="rr-player-list">

              {activePlayers.map(player => (
                <div
                  className="rr-player-row"
                  key={player.id}
                >
                  <span
                    className="rr-player-number"
                    style={{
                      background:player.color
                    }}
                  >
                    {player.number}
                  </span>

                  <b>
                    {player.name}
                  </b>
                </div>
              ))}

            </div>

          </aside>

          <section className="rr-wheel-stage">

            <div className="rr-screen-label">
              اختيار صاحب الدور
            </div>

            <div className="rr-wheel-wrap">

              <div className="rr-pointer">
                ▼
              </div>

              <div
                className="rr-wheel"
                style={{
                  background:
                    wheelBackground,
                  transform:
                    `translateX(-50%) rotate(${rotation}deg)`,
                  transition:
                    spinning
                      ? 'transform 3.9s cubic-bezier(.10,.72,.10,1)'
                      : 'none'
                }}
              >

                {activePlayers.map(
                  (player, index) => {

                    const angle =
                      index * part +
                      part / 2

                    const radius =
                      activePlayers.length > 18
                        ? 182
                        : 171

                    return (
                      <div
                        className="rr-wheel-name"
                        key={player.id}
                        style={{
                          transform:
                            `rotate(${angle}deg) translateY(-${radius}px) rotate(${-angle}deg)`
                        }}
                      >
                        <b style={{
                          fontSize:
                            activePlayers.length > 20
                              ? 8
                              : activePlayers.length > 12
                                ? 10
                                : 12
                        }}>
                          {player.name}
                        </b>
                      </div>
                    )
                  }
                )}

                <button
                  className="rr-wheel-center"
                  onClick={spinWheel}
                  disabled={spinning}
                >
                  <b>مشهور</b>

                  <small>
                    {spinning
                      ? 'تدور...'
                      : 'لف'}
                  </small>
                </button>

              </div>

            </div>

            <div className="rr-selected-name">
              <small>
                {spinning
                  ? 'جاري الاختيار'
                  : chooser
                    ? 'صاحب الدور'
                    : 'اضغط وسط العجلة'}
              </small>

              <h1>
                {chooser
                  ? chooser.name
                  : '—'}
              </h1>
            </div>

          </section>

        </main>
      )}

      {/* الشاشة الثانية: اختيار الضحية */}
      {screen === 'choose' && chooser && (
        <main className="rr-choose-screen">

          <div className="rr-chooser-card">

            <small>
              صاحب الدور
            </small>

            <h1>
              {chooser.name}
            </h1>

            <p>
              اختر الشخص الذي ستُجرى عليه المحاولة
            </p>

            <div className="rr-target-grid">

              {activePlayers
                .filter(
                  player =>
                    player.id !== chooser.id
                )
                .map(player => (
                  <button
                    key={player.id}
                    className="rr-target-card"
                    onClick={() =>
                      chooseTarget(player)
                    }
                  >

                    <span
                      className="rr-target-number"
                      style={{
                        background:player.color
                      }}
                    >
                      {player.number}
                    </span>

                    <b>
                      {player.name}
                    </b>

                  </button>
                ))}

            </div>

            <div className="rr-chat-hint">
              {chooser.name} يختار رقم لاعب
            </div>

          </div>

        </main>
      )}

      {/* الشاشة الثالثة: المسدس */}
      {screen === 'gun' && target && (
        <main
          className={
            `rr-gun-screen ${
              gunState === 'bang'
                ? 'is-bang'
                : gunState === 'safe'
                  ? 'is-safe'
                  : ''
            }`
          }
        >

          <div className="rr-gun-person">

            <small>
              المحاولة على
            </small>

            <h1>
              {target.name}
            </h1>

          </div>

          <div className="rr-gun-stage">

            <div className="rr-revolver">

              <div className="rr-barrel" />
              <div className="rr-barrel-tip" />

              <div className="rr-body">

                <div className="rr-cylinder">
                  {[0,1,2,3,4,5].map(i => (
                    <span key={i} />
                  ))}
                </div>

              </div>

              <div className="rr-trigger-ring">
                <div className="rr-trigger" />
              </div>

              <div className="rr-grip" />

            </div>

          </div>

          {/* المحاولات الست */}
          <div className="rr-attempts">

            <div className="rr-attempt-title">
              المحاولات
            </div>

            <div className="rr-attempt-row">

              {[0,1,2,3,4,5].map(i => (
                <div
                  key={i}
                  className={
                    `rr-attempt-dot ${
                      i < attemptIndex
                        ? 'done'
                        : i === attemptIndex
                          ? gunState === 'bang'
                            ? 'bang'
                            : 'current'
                          : ''
                    }`
                  }
                >
                  {i + 1}
                </div>
              ))}

            </div>

          </div>

          <div className="rr-gun-result">

            {gunState === 'waiting' && (
              <span className="rr-loading">
                ●
              </span>
            )}

            {gunState === 'safe' && (
              <h2 className="rr-safe-text">
                نجا
              </h2>
            )}

            {gunState === 'bang' && (
              <h2 className="rr-bang-text">
                💥 خرج من اللعبة
              </h2>
            )}

          </div>

        </main>
      )}

    </div>
  )
}

