    border-radius:99px;
    background:#0b0f0b;
  }

  .rr-barrel-tip{
    position:absolute;
    z-index:7;
    width:23px;
    height:61px;
    left:5px;
    top:51px;
    border:4px solid #39423a;
    border-radius:7px;
    background:#080b08;
  }

  .rr-body{
    position:absolute;
    z-index:6;
    width:175px;
    height:118px;
    left:215px;
    top:43px;
    border:4px solid #333d34;
    border-radius:22px 24px 17px 20px;
    background:
      linear-gradient(145deg,#272e27,#0f140f);
    box-shadow:0 13px 30px rgba(0,0,0,.5);
  }

  .rr-cylinder{
    position:absolute;
    width:94px;
    height:94px;
    left:25px;
    top:8px;
    border:5px solid #3c463d;
    border-radius:50%;
    background:#111711;
    transform:rotate(15deg);
  }

  .rr-cylinder span{
    position:absolute;
    width:18px;
    height:18px;
    border:3px solid #343e35;
    border-radius:50%;
    background:#070a07;
  }

  .rr-cylinder span:nth-child(1){left:35px;top:6px}
  .rr-cylinder span:nth-child(2){left:60px;top:21px}
  .rr-cylinder span:nth-child(3){left:60px;top:52px}
  .rr-cylinder span:nth-child(4){left:35px;top:67px}
  .rr-cylinder span:nth-child(5){left:10px;top:52px}
  .rr-cylinder span:nth-child(6){left:10px;top:21px}

  .rr-trigger-ring{
    position:absolute;
    z-index:8;
    width:75px;
    height:57px;
    left:292px;
    top:142px;
    border:7px solid #293229;
    border-radius:10px 10px 45px 45px;
  }

  .rr-trigger{
    position:absolute;
    width:9px;
    height:32px;
    left:22px;
    top:-4px;
    border-radius:8px;
    background:#9eff28;
    transform:rotate(-17deg);
  }

  .rr-grip{
    position:absolute;
    z-index:5;
    width:91px;
    height:125px;
    left:354px;
    top:125px;
    border:4px solid #2f3830;
    border-radius:8px 17px 32px 15px;
    background:
      repeating-linear-gradient(
        45deg,
        #171d17 0 8px,
        #111611 8px 16px
      );
    transform:rotate(-12deg);
    transform-origin:top;
  }

  .rr-attempts{
    text-align:center;
    margin-top:4px;
  }

  .rr-attempt-title{
    color:#6f7a70;
    font-size:10px;
    margin-bottom:8px;
  }

  .rr-attempt-row{
    display:flex;
    justify-content:center;
    gap:9px;
  }

  .rr-attempt-dot{
    width:35px;
    height:35px;
    display:grid;
    place-items:center;
    border:1px solid #303a31;
    border-radius:10px;
    background:#0a0e0a;
    color:#566057;
    font-size:11px;
    font-weight:900;
    transition:.2s;
  }

  .rr-attempt-dot.done{
    border-color:#39523b;
    color:#84a187;
    background:#101710;
  }

  .rr-attempt-dot.current{
    border-color:#9eff28;
    color:#9eff28;
    box-shadow:0 0 18px rgba(158,255,40,.12);
  }

  .rr-attempt-dot.bang{
    border-color:#ff4f58;
    color:#ff626a;
    background:#1b0d0e;
  }

  .rr-gun-result{
    min-height:65px;
    margin-top:12px;
    text-align:center;
  }

  .rr-loading{
    color:#9eff28;
    font-size:20px;
    animation:rrPulse .75s ease infinite;
  }

  .rr-safe-text{
    margin:0;
    color:#9eff28;
    font-size:34px;
    animation:rrPop .25s ease;
  }

  .rr-bang-text{
    margin:0;
    color:#ff5a62;
    font-size:34px;
    animation:rrPop .25s ease;
  }

  .is-bang::after{
    content:'';
    position:fixed;
    inset:0;
    z-index:2;
    pointer-events:none;
    background:rgba(255,30,40,.18);
    animation:rrFlash .4s ease forwards;
  }

  .is-bang .rr-revolver{
    animation:rrKick .32s ease;
  }

  .is-safe .rr-trigger{
    animation:rrTrigger .25s ease;
  }

  @keyframes rrPulse{
    50%{opacity:.2}
  }

  @keyframes rrPop{
    from{
      opacity:0;
      transform:scale(.75);
    }
  }

  @keyframes rrFlash{
    from{opacity:1}
    to{opacity:0}
  }

  @keyframes rrKick{
    0%{
      transform:translate(-50%,-50%);
    }
    45%{
      transform:translate(-46%,-57%) rotate(-7deg);
    }
    100%{
      transform:translate(-50%,-50%);
    }
  }

  @keyframes rrTrigger{
    50%{
      transform:rotate(18deg);
    }
  }

  /* الفائز */

  .rr-winner{
    display:grid;
    place-items:center;
  }

  .rr-winner-card{
    width:min(600px,94vw);
    text-align:center;
    padding:45px;
    border:1px solid rgba(158,255,40,.3);
    border-radius:24px;
    background:#080d08;
    box-shadow:0 30px 90px #000;
  }

  .rr-trophy{
    font-size:65px;
  }

  .rr-winner-card small{
    color:#768276;
  }

  .rr-winner-card h1{
    margin:8px 0 30px;
    color:#9eff28;
    font-size:50px;
  }

  @media(max-width:850px){
    .rr-selection{
      grid-template-columns:1fr;
    }

    .rr-players{
      order:2;
    }

    .rr-player-list{
      max-height:200px;
    }
  }

  @media(max-width:650px){
    .rr-target-grid{
      grid-template-columns:
        repeat(2,minmax(0,1fr));
    }

    .rr-gun-stage{
      height:230px;
    }

    .rr-revolver{
      transform:
        translate(-50%,-50%) scale(.75);
    }
  }
`
