            <div className="mh-stage-card bottom">
              <span>!دخول</span>
              <b>من الشات مباشرة</b>
            </div>
          </div>

        </section>

        <section
          className="mh-games"
          id="mh-games"
        >
          <div className="mh-section-head">
            <div>
              <span>اختر لعبتك</span>
              <h2>ألعاب مشهور</h2>
            </div>

            <p>
              كل لعبة لها شخصيتها،
